Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\\.php|config\\.local\\.php|config\\.example\\.php|bootstrap\\.php|schema\\.sql|README\\.md|\\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin-api/?$ admin.php [QSA,L]
  RewriteRule ^admin-api/(.*)$ admin.php?route=/$1 [QSA,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>
